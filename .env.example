# ==============================================================================
# Pipefy MCP Server Configuration (Gemini Enterprise & Antigravity)
# ==============================================================================

# Option 1: Personal Access Token (Fastest for initial setup / local Antigravity testing)
# Generate at: https://app.pipefy.com/tokens
PIPEFY_TOKEN=your_personal_access_token_here

# Option 2: Service Account (Recommended for Production / Cloud Run / Gemini Enterprise)
# Generate in Pipefy: Company Settings -> Service Accounts
PIPEFY_SERVICE_ACCOUNT_CLIENT_ID=your_client_id_here
PIPEFY_SERVICE_ACCOUNT_CLIENT_SECRET=your_client_secret_here

# Toolset Filtering (Crucial for Gemini Enterprise: Keep enabled tools < 100)
# Valid options: 'workflow,database' or persona profiles like 'operator', 'requester', 'power'
PIPEFY_MCP_TOOLSETS=workflow,database

# Server Network Settings
HOST=0.0.0.0
PORT=8080

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
